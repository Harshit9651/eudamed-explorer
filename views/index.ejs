
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EUDAMED Device Explorer</title>
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

  <style>
    * { box-sizing: border-box; }
    :root {
      --primary: #3659e3;
      --text: #192238;
      --muted: #718096;
      --border: #e6eaf2;
      --background: #f5f7fc;
    }

    body {
      margin: 0;
      padding: 32px;
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
      color: var(--text);
      background: radial-gradient(ellipse at top left, #e9edff 0, transparent 38%), var(--background);
    }

    button, input, select { font: inherit; }
    button { cursor: pointer; transition: .2s; }
    button:hover { transform: translateY(-1px); }
    button:disabled { opacity: .55; cursor: not-allowed; transform: none; }

    .container { max-width: 1800px; margin: auto; }
    .topbar, .brand, .results-header, .results-actions { display: flex; align-items: center; gap: 16px; }
    .topbar, .results-header { justify-content: space-between; flex-wrap: wrap; }
    .topbar { margin-bottom: 28px; }
    .brand { gap: 14px; }

    .brand-icon {
      display: grid; place-items: center; width: 54px; height: 54px;
      color: white; font-size: 25px; border-radius: 16px;
      background: linear-gradient(135deg, #526df5, #273eb8);
      box-shadow: 0 9px 24px #3659e333;
    }

    h1 { margin: 0 0 6px; font-size: clamp(24px, 3vw, 34px); letter-spacing: -1px; }
    .subtitle, .results-description { margin: 0; color: var(--muted); font-size: 13px; }

    .status-pill {
      display: inline-flex; align-items: center; gap: 8px; padding: 9px 13px;
      border: 1px solid #d9e9dd; border-radius: 30px; color: #267446;
      background: #f0fbf3; font-size: 12px; font-weight: 700;
    }

    .status-dot { width: 7px; height: 7px; background: #25a55b; border-radius: 50%; }
    .panel { padding: 25px; margin-bottom: 22px; background: white; border: 1px solid var(--border); border-radius: 18px; box-shadow: 0 8px 30px #23355d08; }
    .section-heading { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; font-size: 16px; font-weight: 750; }
    .section-heading span { display: grid; place-items: center; width: 32px; height: 32px; color: var(--primary); background: #edf0ff; border-radius: 9px; }

    .filters { display: grid; grid-template-columns: minmax(200px, 1.5fr) minmax(200px, 1fr) auto; gap: 16px; align-items: end; }
    .field { display: flex; min-width: 0; flex-direction: column; gap: 9px; }
    label { font-size: 13px; font-weight: 700; color: #364152; }

    input, select {
      width: 100%; min-height: 47px; padding: 0 14px; color: var(--text);
      outline: none; border: 1px solid #dce2ed; border-radius: 10px; background: white;
    }
    input:focus, select:focus { border-color: var(--primary); box-shadow: 0 0 0 4px #3659e318; }

    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 9px;
      min-height: 44px; padding: 0 17px; white-space: nowrap;
      border: 0; border-radius: 10px; font-size: 13px; font-weight: 750;
    }
    .btn-primary { color: white; background: linear-gradient(135deg, #4967f2, #3450d4); }
    .btn-excel { color: #176b45; background: #e8f7ef; border: 1px solid #cdebd9; }
    .btn-secondary { color: #46536a; background: #f0f3f8; border: 1px solid var(--border); }

    .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-bottom: 22px; }
    .stat-card { display: flex; align-items: center; gap: 15px; padding: 20px; background: white; border: 1px solid var(--border); border-radius: 15px; }
    .stat-icon { display: grid; flex-shrink: 0; place-items: center; width: 45px; height: 45px; border-radius: 13px; font-size: 21px; background: #edf0ff; }
    .stat-icon.green { background: #e6f7ed; }
    .stat-icon.orange { background: #fff3df; }
    .stat-label { margin-bottom: 6px; color: var(--muted); font-size: 12px; }
    .stat-value { font-size: 25px; font-weight: 800; overflow-wrap: anywhere; }

    .results-header { margin-bottom: 17px; }
    .results-title { margin: 0 0 6px; font-size: 19px; font-weight: 800; }
    .results-actions { flex-wrap: wrap; gap: 10px; }
    .table-wrap { overflow: auto; max-height: 70vh; border: 1px solid var(--border); border-radius: 13px; background: white; }

    table { width: 100%; min-width: 1450px; border-collapse: separate; border-spacing: 0; }
    thead th { position: sticky; top: 0; z-index: 2; padding: 14px; text-align: left; white-space: nowrap; color: #596780; background: #f6f8fc; border-bottom: 1px solid var(--border); font-size: 11px; letter-spacing: .4px; text-transform: uppercase; }
    tbody td { padding: 14px; border-bottom: 1px solid #edf0f5; font-size: 12px; line-height: 1.6; vertical-align: top; overflow-wrap: anywhere; max-width: 280px; }
    tbody tr:hover { background: #f7f9ff; }
    .index-cell { color: #8792a6; font-weight: 700; }
    .device-name { color: #253f9c; font-weight: 750; }
    .risk { display: inline-flex; padding: 5px 9px; color: #8a5a00; background: #fff3d6; border: 1px solid #f6e5b8; border-radius: 7px; white-space: nowrap; font-weight: 750; }

    .details-button { color: var(--primary); background: #eef1ff; border: 1px solid #dce3ff; border-radius: 8px; padding: 9px 12px; font-weight: 750; white-space: nowrap; }
    .details-button:hover { background: #e1e7ff; }

    .modal-overlay { position: fixed; inset: 0; z-index: 10000; display: none; place-items: center; padding: 22px; background: #101828a8; backdrop-filter: blur(5px); }
    .modal-overlay.active { display: grid; animation: fadeIn .18s ease; }
    .details-modal { display: flex; flex-direction: column; width: min(1050px, 100%); max-height: 88vh; background: white; border-radius: 18px; overflow: hidden; box-shadow: 0 28px 90px #10182855; animation: popIn .22s ease; }
    .modal-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; padding: 22px 26px; border-bottom: 1px solid var(--border); background: linear-gradient(135deg, #f8faff, #eef2ff); }
    .modal-header h2 { margin: 0 0 6px; font-size: 21px; overflow-wrap: anywhere; }
    .modal-subtitle { margin: 0; color: var(--muted); font-size: 13px; overflow-wrap: anywhere; }
    .modal-close { width: 38px; height: 38px; flex-shrink: 0; border: 1px solid var(--border); border-radius: 10px; background: white; color: #475467; font-size: 23px; }
    .modal-body { overflow: auto; padding: 22px 26px 28px; }
    .detail-section { margin-bottom: 23px; }
    .detail-section h3 { margin: 0 0 11px; color: #344054; font-size: 13px; letter-spacing: .04em; text-transform: uppercase; }
    .detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .detail-item { min-width: 0; padding: 12px 14px; background: #f8faff; border: 1px solid #e8edf6; border-radius: 10px; }
    .detail-key { margin-bottom: 5px; color: #667085; font-size: 11px; font-weight: 750; text-transform: uppercase; overflow-wrap: anywhere; }
    .detail-value { color: #1d2939; font-size: 13px; line-height: 1.55; overflow-wrap: anywhere; white-space: pre-wrap; }
    .empty-value { color: #98a2b3; font-style: italic; }
    .empty { padding: 55px 20px; text-align: center; color: var(--muted); }
    .error { margin-bottom: 20px; padding: 16px; color: #a52828; background: #fff0f0; border: 1px solid #ffd4d4; border-radius: 12px; overflow-wrap: anywhere; }
    .footer { padding: 22px 0 5px; text-align: center; color: #8a95a8; font-size: 12px; }

    .loader-overlay { position: fixed; inset: 0; z-index: 9999; display: none; place-items: center; padding: 20px; background: #111a2b99; backdrop-filter: blur(7px); }
    .loader-overlay.active { display: grid; animation: fadeIn .2s ease; }
    .loader-card { width: min(390px, 100%); padding: 34px; text-align: center; background: white; border-radius: 22px; box-shadow: 0 30px 100px #101b3b40; animation: popIn .35s ease; }
    .loader-animation { position: relative; display: grid; place-items: center; width: 88px; height: 88px; margin: 0 auto 23px; }
    .loader-ring { position: absolute; inset: 0; border: 4px solid #e6eaff; border-top-color: #4865f1; border-right-color: #8e9fff; border-radius: 50%; animation: spin 1s linear infinite; }
    .ring-two { inset: 10px; position: absolute; border: 3px solid transparent; border-bottom-color: #36b37e; border-left-color: #36b37e; border-radius: 50%; animation: spin 1.5s linear infinite reverse; }
    .loader-symbol { font-size: 29px; animation: pulse 1.4s ease-in-out infinite; }
    .loader-card h2 { margin: 0 0 9px; font-size: 20px; }
    .loader-card p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.7; }
    .loader-progress { height: 5px; margin-top: 23px; overflow: hidden; background: #edf0fa; border-radius: 20px; }
    .loader-progress span { display: block; width: 38%; height: 100%; border-radius: 20px; background: linear-gradient(90deg, #4967f2, #36b37e); animation: progressMove 1.5s ease-in-out infinite; }

    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes pulse { 50% { transform: scale(1.12); } }
    @keyframes progressMove { 0% { transform: translateX(-110%); } 100% { transform: translateX(280%); } }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @keyframes popIn { from { opacity: 0; transform: translateY(12px) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }

    @media (max-width: 850px) {
      body { padding: 18px; }
      .filters, .stats { grid-template-columns: 1fr; }
      .panel { padding: 18px; }
      .results-actions { width: 100%; }
      .results-actions .btn { flex: 1; }
    }
    @media (max-width: 650px) {
      .modal-overlay { padding: 10px; }
      .modal-header, .modal-body { padding: 17px; }
      .detail-grid { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; }
    }
  </style>
</head>

<body>
<div class="container">
  <header class="topbar">
    <div class="brand">
      <div class="brand-icon">✚</div>
      <div>
        <h1>EUDAMED Explorer</h1>
        <p class="subtitle">Medical device intelligence &amp; registry data</p>
      </div>
    </div>
    <div class="status-pill"><span class="status-dot"></span> Device data explorer</div>
  </header>

  <section class="panel">
    <div class="section-heading"><span>⌕</span> Search and filter devices</div>
    <form id="searchForm" action="/search" method="POST">
      <div class="filters">
        <div class="field">
          <label for="code">EMDN nomenclature code</label>
          <input id="code" name="code" value="<%= code %>" placeholder="e.g. W0105090108" required autocomplete="off">
        </div>
        <div class="field">
          <label for="riskClass">Filter by risk class</label>
          <select id="riskClass" name="riskClass">
            <option value="all" <%= selectedRisk === "all" ? "selected" : "" %>>All available risk classes</option>
            <% riskClasses.forEach((risk) => { %>
              <option value="<%= risk.id %>" <%= selectedRisk === risk.id ? "selected" : "" %>><%= risk.label %></option>
            <% }) %>
          </select>
        </div>
        <button class="btn btn-primary" id="searchButton" type="submit">⌕ Search devices</button>
      </div>
    </form>
  </section>

  <% if (error) { %>
    <div class="error"><strong>Something went wrong</strong><p><%= error %></p></div>
  <% } %>

  <section class="stats">
    <div class="stat-card"><div class="stat-icon">▤</div><div><div class="stat-label">Records displayed</div><div class="stat-value"><%= rows.length.toLocaleString() %></div></div></div>
    <div class="stat-card"><div class="stat-icon green">⇩</div><div><div class="stat-label">Records fetched</div><div class="stat-value"><%= (totalRecords || 0).toLocaleString() %></div></div></div>
    <div class="stat-card"><div class="stat-icon orange">⚑</div><div><div class="stat-label">Risk classes available</div><div class="stat-value"><%= riskClasses.length %></div></div></div>
  </section>

  <section>
    <div class="results-header">
      <div>
        <h2 class="results-title">Device records</h2>
        <p class="results-description">EMDN code: <strong><%= code %></strong> · Export includes displayed records and their full details.</p>
      </div>
      <div class="results-actions">
        <button class="btn btn-excel" id="downloadExcel" type="button" <%= rows.length === 0 ? "disabled" : "" %>>▦ Download Excel</button>
        <button class="btn btn-secondary" id="downloadCsv" type="button" <%= rows.length === 0 ? "disabled" : "" %>>Download CSV</button>
      </div>
    </div>

    <div class="table-wrap">
      <table id="deviceTable">
        <thead>
          <tr>
            <th>#</th><th>Trade name</th><th>Device name</th><th>Device model</th>
            <th>Primary DI</th><th>Basic UDI</th><th>Reference</th><th>Risk class</th>
            <th>Manufacturer</th><th>Manufacturer SRN</th><th>Device status ID</th>
            <th>Authorised representative</th><th>AR SRN</th><th>Criterion</th><th>Details</th>
          </tr>
        </thead>
        <tbody>
          <% if (rows.length === 0) { %>
            <tr><td colspan="15"><div class="empty"><strong>No records to display</strong><p>Enter an EMDN code and search for matching devices.</p></div></td></tr>
          <% } %>
          <% rows.forEach((row, index) => { %>
            <tr>
              <td class="index-cell"><%= index + 1 %></td>
              <td class="device-name"><%= row.TRADE_NAME ?? "-" %></td>
              <td><%= row.DEVICE_NAME ?? "-" %></td>
              <td><%= row.DEVICE_MODEL ?? "-" %></td>
              <td><%= row.PRIMARY_DI ?? "-" %></td>
              <td><%= row.BASIC_UDI ?? "-" %></td>
              <td><%= row.REFERENCE ?? "-" %></td>
              <td><span class="risk"><%= row.riskLabel ?? "-" %></span></td>
              <td><%= row.MF_NAME ?? "-" %></td>
              <td><%= row.MF_SRN ?? "-" %></td>
              <td><%= row.DEVICE_STATUS_TYPE_ID ?? "-" %></td>
              <td><%= row.AR_NAME ?? "-" %></td>
              <td><%= row.AR_SRN ?? "-" %></td>
              <td><%= row.DEVICE_CRITERION ?? "-" %></td>
              <td><button class="details-button" type="button" data-row-index="<%= index %>">View all data ↗</button></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <footer class="footer">EUDAMED Explorer · Data is presented for research and review.</footer>
</div>

<div class="modal-overlay" id="detailsModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <section class="details-modal">
    <header class="modal-header">
      <div>
        <h2 id="modalTitle">Device details</h2>
        <p class="modal-subtitle" id="modalSubtitle">Complete record from EUDAMED</p>
      </div>
      <button class="modal-close" id="closeDetailsModal" type="button" aria-label="Close details">×</button>
    </header>
    <div class="modal-body" id="modalBody"></div>
  </section>
</div>

<div class="loader-overlay" id="loaderOverlay" aria-live="polite">
  <div class="loader-card">
    <div class="loader-animation"><div class="loader-ring"></div><div class="ring-two"></div><div class="loader-symbol">✚</div></div>
    <h2>Fetching device records</h2>
    <p>Connecting to the EUDAMED data service.<br>Large result sets may take a little longer.</p>
    <div class="loader-progress"><span></span></div>
  </div>
</div>

<script>
  const searchForm = document.getElementById("searchForm");
  const loader = document.getElementById("loaderOverlay");
  const searchButton = document.getElementById("searchButton");
  const detailsModal = document.getElementById("detailsModal");
  const modalBody = document.getElementById("modalBody");

  searchForm.addEventListener("submit", () => {
    loader.classList.add("active");
    searchButton.disabled = true;
    searchButton.textContent = "Searching...";
  });

  // Data already filtered by the server.
  const deviceRows = <%- JSON.stringify(rows).replace(/</g, "\\u003c") %>;

  function readableKey(key) {
    return String(key)
      .replace(/_/g, " ")
      .replace(/([a-z])([A-Z])/g, "$1 $2")
      .toLowerCase()
      .replace(/\b\w/g, char => char.toUpperCase());
  }

  function tryParseJson(value) {
    if (typeof value !== "string") return value;

    const text = value.trim();
    if (!text || (!text.startsWith("{") && !text.startsWith("["))) return value;

    try {
      return JSON.parse(text);
    } catch {
      return value;
    }
  }

  // Extract the human-readable name from EUDAMED's nested actor JSON.
  function formatActorNames(value) {
    value = tryParseJson(value);

    if (value === null || value === undefined || value === "") {
      return "Not provided";
    }

    if (typeof value === "string") return value;

    if (Array.isArray(value)) {
      const values = value
        .map(item => formatActorNames(item))
        .filter(item => item !== "Not provided");

      return values.length ? values.join(", ") : "Not provided";
    }

    if (typeof value === "object") {
      if (value.textByDefaultLanguage) {
        return String(value.textByDefaultLanguage);
      }

      if (value.text) return String(value.text);

      if (Array.isArray(value.texts)) {
        const texts = value.texts
          .map(item => item?.text)
          .filter(Boolean);

        if (texts.length) return texts.join(", ");
      }

      // Preserve readable information for other object formats.
      return Object.entries(value)
        .map(([key, child]) => {
          const formatted = formatActorNames(child);
          return formatted !== "Not provided"
            ? `${readableKey(key)}: ${formatted}`
            : "";
        })
        .filter(Boolean)
        .join(" | ") || "Not provided";
    }

    return String(value);
  }

  const actorFields = new Set([
    "MF_ACTOR_NAMES",
    "ACTOR_ABBREVIATED_NAMES",
    "AR_ACTOR_NAMES"
  ]);

  function displayValue(value, key = "") {
    if (value === null || value === undefined || value === "") {
      return "Not provided";
    }

    if (actorFields.has(key)) {
      return formatActorNames(value);
    }

    value = tryParseJson(value);

    if (value && typeof value === "object") {
      return formatActorNames(value);
    }

    return String(value);
  }

  function createDetailItem(key, value) {
    const item = document.createElement("div");
    item.className = "detail-item";

    const label = document.createElement("div");
    label.className = "detail-key";
    label.textContent = readableKey(key);

    const content = document.createElement("div");
    content.className = "detail-value";
    content.textContent = displayValue(value, key);

    if (content.textContent === "Not provided") {
      content.classList.add("empty-value");
    }

    item.append(label, content);
    return item;
  }

  function renderDeviceDetails(row) {
    modalBody.replaceChildren();

    const sections = [
      {
        title: "Device information",
        keys: [
          "ID", "UUID", "UDI_DI_DATA_ULID", "TRADE_NAME",
          "DEVICE_NAME", "DEVICE_MODEL", "REFERENCE", "PRIMARY_DI",
          "BASIC_UDI", "BASIC_UDI_DATA_UUID", "BASIC_UDI_DATA_ULID",
          "UNIT_OF_USE_DI", "DIRECT_MARKETING_DI", "SECONDARY_DI",
          "CONTAINER_PACKAGE_DIS", "VERSION_NUMBER", "LATEST_VERSION"
        ]
      },
      {
        title: "Risk & regulatory classification",
        keys: [
          "riskLabel", "RISK_CLASS_ID", "APPLICABLE_LEGISLATION_ID",
          "NOMENCLATURE_CODE", "DEVICE_CRITERION", "MEDICAL_PURPOSE"
        ]
      },
      {
        title: "Manufacturer details",
        keys: [
          "MF_NAME", "MF_SRN", "MF_ACTOR_NAMES", "ACTOR_ABBREVIATED_NAMES"
        ]
      },
      {
        title: "Authorised representative",
        keys: ["AR_NAME", "AR_SRN", "AR_ACTOR_NAMES"]
      },
      {
        title: "Status & compliance",
        keys: [
          "DEVICE_STATUS_TYPE_ID", "STATUS_ID", "PLACED_ON_THE_MARKET_ID",
          "SUBSTATUSES", "ACTIVE", "STERILE", "STERILIZATION", "LATEX",
          "CMR_SUBSTANCE", "ENDOCRINE_DISRUPTOR", "REPROCESSED", "NEW_DEVICE"
        ]
      },
      {
        title: "Device characteristics",
        keys: [
          "ADMINISTERING_MEDICINE", "ANIMAL_TISSUES",
          "COMPANION_DIAGNOSTICS", "HUMAN_TISSUES", "IMPLANTABLE", "KIT",
          "MEASURING_FUNCTION", "MICROBIAL_SUBSTANCES", "NEAR_PATIENT_TESTING",
          "REUSABLE", "SELF_TESTING", "SPECIAL_DEVICE_TYPE_ID", "REAGENT",
          "MULTI_COMPONENT_ID", "INSTRUMENT", "PROFESSIONAL_TESTING",
          "SUTURES", "HUMAN_PRODUCT", "MEDICINAL_PRODUCT"
        ]
      }
    ];

    const used = new Set();

    sections.forEach(section => {
      const keys = section.keys.filter(key =>
        Object.prototype.hasOwnProperty.call(row, key)
      );

      if (!keys.length) return;

      const wrapper = document.createElement("section");
      wrapper.className = "detail-section";

      const heading = document.createElement("h3");
      heading.textContent = section.title;

      const grid = document.createElement("div");
      grid.className = "detail-grid";

      keys.forEach(key => {
        grid.appendChild(createDetailItem(key, row[key]));
        used.add(key);
      });

      wrapper.append(heading, grid);
      modalBody.appendChild(wrapper);
    });

    // Include every remaining API field as well.
    const remaining = Object.keys(row).filter(key => !used.has(key));

    if (remaining.length) {
      const wrapper = document.createElement("section");
      wrapper.className = "detail-section";

      const heading = document.createElement("h3");
      heading.textContent = "Other fields";

      const grid = document.createElement("div");
      grid.className = "detail-grid";

      remaining.forEach(key => {
        grid.appendChild(createDetailItem(key, row[key]));
      });

      wrapper.append(heading, grid);
      modalBody.appendChild(wrapper);
    }

    document.getElementById("modalTitle").textContent =
      row.TRADE_NAME || row.DEVICE_NAME || "Device details";

    document.getElementById("modalSubtitle").textContent =
      `Primary DI: ${row.PRIMARY_DI || "Not provided"} · Risk class: ${row.riskLabel || "Not provided"}`;

    detailsModal.classList.add("active");
    document.body.style.overflow = "hidden";
    document.getElementById("closeDetailsModal").focus();
  }

  document.querySelectorAll(".details-button").forEach(button => {
    button.addEventListener("click", () => {
      const row = deviceRows[Number(button.dataset.rowIndex)];
      if (row) renderDeviceDetails(row);
    });
  });

  function closeDetailsModal() {
    detailsModal.classList.remove("active");
    document.body.style.overflow = "";
  }

  document.getElementById("closeDetailsModal").addEventListener("click", closeDetailsModal);

  detailsModal.addEventListener("click", event => {
    if (event.target === detailsModal) closeDetailsModal();
  });

  document.addEventListener("keydown", event => {
    if (event.key === "Escape") closeDetailsModal();
  });

  function createFilename(extension) {
    const code = document.getElementById("code").value.trim()
      .replace(/[^a-zA-Z0-9_-]/g, "_");

    const risk = document.getElementById("riskClass").value
      .replace(/[^a-zA-Z0-9_-]/g, "_");

    return `EUDAMED_${code}_${risk === "all" ? "all_risks" : "risk_" + risk}.${extension}`;
  }

  // Flatten nested data; actor-name JSON becomes readable text in Excel too.
  function flattenObject(value, prefix = "", result = {}) {
    const fieldName = prefix.split(".").pop();

    if (actorFields.has(fieldName)) {
      result[prefix] = formatActorNames(value);
      return result;
    }

    value = tryParseJson(value);

    if (value && typeof value === "object" && !Array.isArray(value)) {
      const entries = Object.entries(value);

      if (!entries.length && prefix) result[prefix] = "{}";

      entries.forEach(([key, child]) => {
        const nextKey = prefix ? `${prefix}.${key}` : key;
        flattenObject(child, nextKey, result);
      });
    } else if (Array.isArray(value)) {
      if (!value.length) result[prefix] = "[]";

      value.forEach((child, index) => {
        flattenObject(child, `${prefix}[${index + 1}]`, result);
      });
    } else {
      result[prefix] = value === null || value === undefined ? "" : value;
    }

    return result;
  }

  function getFullDetailSheetRows() {
    const flattened = deviceRows.map(row => flattenObject(row));
    const keys = [...new Set(flattened.flatMap(row => Object.keys(row)))];

    return [
      keys,
      ...flattened.map(row => keys.map(key => row[key] ?? ""))
    ];
  }

  function getMainTableRows() {
    const table = document.getElementById("deviceTable");
    const headers = [...table.querySelectorAll("thead th")];

    const columns = headers
      .map((th, index) => ({ title: th.innerText.trim(), index }))
      .filter(item => item.title !== "#" && item.title !== "Details");

    const bodyRows = [...table.querySelectorAll("tbody tr")]
      .filter(tr => tr.querySelectorAll(":scope > td").length > 1)
      .map(tr => {
        const cells = [...tr.querySelectorAll(":scope > td")];

        return columns.map(item => {
          const cell = cells[item.index];
          if (!cell) return "";

          const rowIndex = tr.rowIndex - 1;
          const row = deviceRows[rowIndex];

          // Use original data for actor fields so nested JSON never leaks into export.
          const actorKeyByColumn = {
            "Manufacturer": "MF_NAME",
            "Authorised representative": "AR_NAME"
          };

          const actorKey = actorKeyByColumn[item.title];
          if (actorKey && row && row[actorKey]) return row[actorKey];

          return cell.innerText.trim();
        });
      });

    return [columns.map(item => item.title), ...bodyRows];
  }

  function setColumnWidths(sheet, data) {
    if (!data.length) return;

    sheet["!cols"] = data[0].map((header, index) => {
      const sampleLengths = data.slice(1, 26)
        .map(row => String(row[index] ?? "").length);

      return {
        wch: Math.min(Math.max(String(header).length, ...sampleLengths, 12) + 2, 40)
      };
    });
  }

  document.getElementById("downloadExcel").addEventListener("click", () => {
    if (typeof XLSX === "undefined") {
      alert("Excel library could not load. Check your internet connection.");
      return;
    }

    if (!deviceRows.length) {
      alert("There are no records to export.");
      return;
    }

    const workbook = XLSX.utils.book_new();

    const mainData = getMainTableRows();
    const mainSheet = XLSX.utils.aoa_to_sheet(mainData);
    setColumnWidths(mainSheet, mainData);

    if (mainData[0]?.length) {
      mainSheet["!autofilter"] = {
        ref: XLSX.utils.encode_range({
          s: { r: 0, c: 0 },
          e: { r: mainData.length - 1, c: mainData[0].length - 1 }
        })
      };
    }

    XLSX.utils.book_append_sheet(workbook, mainSheet, "Device Records");

    const detailData = getFullDetailSheetRows();
    const detailSheet = XLSX.utils.aoa_to_sheet(detailData);
    setColumnWidths(detailSheet, detailData);

    if (detailData[0]?.length) {
      detailSheet["!autofilter"] = {
        ref: XLSX.utils.encode_range({
          s: { r: 0, c: 0 },
          e: { r: detailData.length - 1, c: detailData[0].length - 1 }
        })
      };
    }

    XLSX.utils.book_append_sheet(workbook, detailSheet, "All Device Details");
    XLSX.writeFile(workbook, createFilename("xlsx"));
  });

  document.getElementById("downloadCsv").addEventListener("click", () => {
    if (!deviceRows.length) {
      alert("There are no records to export.");
      return;
    }

    const data = getFullDetailSheetRows();

    const csv = data.map(row =>
      row.map(value => `"${String(value ?? "").replace(/"/g, '""')}"`).join(",")
    ).join("\r\n");

    const blob = new Blob(["\uFEFF" + csv], {
      type: "text/csv;charset=utf-8;"
    });

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = createFilename("csv");
    link.click();

    URL.revokeObjectURL(url);
  });
</script>
</body>
</html>
