
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>EUDAMED Device Explorer</title>

  <!-- Excel export library -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

  <style>
    * {
      box-sizing: border-box;
    }

    :root {
      --primary: #3659e3;
      --primary-dark: #2946bd;
      --text: #192238;
      --muted: #718096;
      --border: #e6eaf2;
      --surface: #ffffff;
      --background: #f5f7fc;
    }

    body {
      margin: 0;
      padding: 32px;
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
      color: var(--text);
      background:
        radial-gradient(ellipse at top left, #e9edff 0, transparent 38%),
        var(--background);
    }

    button, input, select {
      font: inherit;
    }

    button {
      cursor: pointer;
      transition: transform .2s, background .2s, box-shadow .2s;
    }

    button:hover {
      transform: translateY(-1px);
    }

    button:disabled {
      cursor: not-allowed;
      opacity: .6;
      transform: none;
    }

    .container {
      max-width: 1800px;
      margin: auto;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 28px;
      flex-wrap: wrap;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .brand-icon {
      display: grid;
      place-items: center;
      width: 54px;
      height: 54px;
      color: white;
      font-size: 25px;
      border-radius: 16px;
      background: linear-gradient(135deg, #526df5, #273eb8);
      box-shadow: 0 9px 24px #3659e333;
    }

    h1 {
      margin: 0 0 6px;
      font-size: clamp(24px, 3vw, 34px);
      letter-spacing: -1px;
    }

    .subtitle {
      margin: 0;
      color: var(--muted);
      font-size: 14px;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 13px;
      border: 1px solid #d9e9dd;
      border-radius: 30px;
      color: #267446;
      background: #f0fbf3;
      font-size: 12px;
      font-weight: 700;
    }

    .status-dot {
      width: 7px;
      height: 7px;
      background: #25a55b;
      border-radius: 50%;
    }

    .panel {
      padding: 25px;
      margin-bottom: 22px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      box-shadow: 0 8px 30px #23355d08;
    }

    .section-heading {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
      font-size: 16px;
      font-weight: 750;
    }

    .section-heading span {
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      color: var(--primary);
      background: #edf0ff;
      border-radius: 9px;
    }

    .filters {
      display: grid;
      grid-template-columns: minmax(200px, 1.5fr) minmax(200px, 1fr) auto;
      gap: 16px;
      align-items: end;
    }

    .field {
      display: flex;
      min-width: 0;
      flex-direction: column;
      gap: 9px;
    }

    label {
      font-size: 13px;
      font-weight: 700;
      color: #364152;
    }

    input, select {
      width: 100%;
      min-height: 47px;
      padding: 0 14px;
      color: var(--text);
      outline: none;
      border: 1px solid #dce2ed;
      border-radius: 10px;
      background: white;
      transition: border .2s, box-shadow .2s;
    }

    input:focus, select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 4px #3659e318;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      min-height: 47px;
      padding: 0 19px;
      white-space: nowrap;
      border: 0;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 750;
    }

    .btn-primary {
      color: white;
      background: linear-gradient(135deg, #4967f2, #3450d4);
      box-shadow: 0 5px 13px #3659e326;
    }

    .btn-primary:hover {
      background: var(--primary-dark);
    }

    .btn-excel {
      color: #176b45;
      background: #e8f7ef;
      border: 1px solid #cdebd9;
    }

    .btn-excel:hover {
      background: #d8f1e3;
    }

    .btn-secondary {
      color: #46536a;
      background: #f0f3f8;
      border: 1px solid var(--border);
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
      margin-bottom: 22px;
    }

    .stat-card {
      display: flex;
      align-items: center;
      gap: 15px;
      min-width: 0;
      padding: 20px;
      background: white;
      border: 1px solid var(--border);
      border-radius: 15px;
      box-shadow: 0 5px 20px #23355d05;
    }

    .stat-icon {
      display: grid;
      flex-shrink: 0;
      place-items: center;
      width: 45px;
      height: 45px;
      border-radius: 13px;
      font-size: 21px;
      background: #edf0ff;
    }

    .stat-icon.green {
      background: #e6f7ed;
    }

    .stat-icon.orange {
      background: #fff3df;
    }

    .stat-label {
      margin-bottom: 6px;
      color: var(--muted);
      font-size: 12px;
    }

    .stat-value {
      font-size: 25px;
      font-weight: 800;
      letter-spacing: -.6px;
      overflow-wrap: anywhere;
    }

    .results-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
      margin-bottom: 17px;
    }

    .results-title {
      margin: 0 0 6px;
      font-size: 19px;
      font-weight: 800;
    }

    .results-description {
      margin: 0;
      color: var(--muted);
      font-size: 13px;
    }

    .results-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .table-wrap {
      overflow: auto;
      max-height: 70vh;
      border: 1px solid var(--border);
      border-radius: 13px;
      background: white;
    }

    table {
      width: 100%;
      min-width: 1550px;
      border-collapse: separate;
      border-spacing: 0;
    }

    thead th {
      position: sticky;
      top: 0;
      z-index: 2;
      padding: 15px 14px;
      text-align: left;
      white-space: nowrap;
      color: #596780;
      background: #f6f8fc;
      border-bottom: 1px solid var(--border);
      font-size: 11px;
      letter-spacing: .45px;
      text-transform: uppercase;
    }

    tbody td {
      padding: 14px;
      border-bottom: 1px solid #edf0f5;
      font-size: 12px;
      line-height: 1.6;
      vertical-align: top;
      overflow-wrap: anywhere;
      max-width: 280px;
    }

    tbody tr {
      transition: background .15s;
    }

    tbody tr:hover {
      background: #f7f9ff;
    }

    tbody tr:last-child td {
      border-bottom: 0;
    }

    .index-cell {
      color: #8792a6;
      font-weight: 700;
    }

    .device-name {
      color: #253f9c;
      font-weight: 750;
    }

    .risk {
      display: inline-flex;
      padding: 5px 9px;
      color: #8a5a00;
      background: #fff3d6;
      border: 1px solid #f6e5b8;
      border-radius: 7px;
      white-space: nowrap;
      font-weight: 750;
    }

    .details summary {
      color: var(--primary);
      cursor: pointer;
      font-weight: 750;
      white-space: nowrap;
    }

    .details pre {
      width: 430px;
      max-height: 350px;
      overflow: auto;
      padding: 14px;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      color: #26334b;
      background: #f5f7fb;
      border: 1px solid var(--border);
      border-radius: 9px;
    }

    .empty {
      padding: 55px 20px;
      text-align: center;
      color: var(--muted);
    }

    .empty-icon {
      margin-bottom: 12px;
      font-size: 35px;
    }

    .error {
      margin-bottom: 20px;
      padding: 16px;
      color: #a52828;
      background: #fff0f0;
      border: 1px solid #ffd4d4;
      border-radius: 12px;
      overflow-wrap: anywhere;
    }

    .footer {
      padding: 22px 0 5px;
      text-align: center;
      color: #8a95a8;
      font-size: 12px;
    }

    /* Loading overlay */
    .loader-overlay {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: none;
      place-items: center;
      padding: 20px;
      background: #111a2b99;
      backdrop-filter: blur(7px);
    }

    .loader-overlay.active {
      display: grid;
      animation: fadeIn .2s ease;
    }

    .loader-card {
      width: min(390px, 100%);
      padding: 34px;
      text-align: center;
      background: white;
      border: 1px solid #ffffff80;
      border-radius: 22px;
      box-shadow: 0 30px 100px #101b3b40;
      animation: popIn .35s ease;
    }

    .loader-animation {
      position: relative;
      display: grid;
      place-items: center;
      width: 88px;
      height: 88px;
      margin: 0 auto 23px;
    }

    .loader-ring {
      position: absolute;
      inset: 0;
      border: 4px solid #e6eaff;
      border-top-color: #4865f1;
      border-right-color: #8e9fff;
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }

    .loader-ring.ring-two {
      inset: 10px;
      border-width: 3px;
      border-color: transparent;
      border-bottom-color: #36b37e;
      border-left-color: #36b37e;
      animation-direction: reverse;
      animation-duration: 1.5s;
    }

    .loader-symbol {
      font-size: 29px;
      animation: pulse 1.4s ease-in-out infinite;
    }

    .loader-card h2 {
      margin: 0 0 9px;
      font-size: 20px;
    }

    .loader-card p {
      margin: 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.7;
    }

    .loader-progress {
      height: 5px;
      margin-top: 23px;
      overflow: hidden;
      background: #edf0fa;
      border-radius: 20px;
    }

    .loader-progress span {
      display: block;
      width: 38%;
      height: 100%;
      border-radius: 20px;
      background: linear-gradient(90deg, #4967f2, #36b37e);
      animation: progressMove 1.5s ease-in-out infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    @keyframes pulse {
      50% { transform: scale(1.12); }
    }

    @keyframes progressMove {
      0% { transform: translateX(-110%); }
      100% { transform: translateX(280%); }
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes popIn {
      from { opacity: 0; transform: translateY(12px) scale(.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    @media (max-width: 850px) {
      body { padding: 18px; }

      .filters {
        grid-template-columns: 1fr;
      }

      .stats {
        grid-template-columns: 1fr;
      }

      .panel { padding: 18px; }

      .results-actions { width: 100%; }

      .results-actions .btn { flex: 1; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>

<body>
<div class="container">

  <header class="topbar">
    <div class="brand">
      <div class="brand-icon">✚</div>
      <div>
        <h1>EUDAMED Explorer</h1>
        <p class="subtitle">Medical device intelligence &amp; registry data</p>
      </div>
    </div>

    <div class="status-pill">
      <span class="status-dot"></span>
      Device data explorer
    </div>
  </header>

  <section class="panel">
    <div class="section-heading">
      <span>⌕</span>
      Search and filter devices
    </div>

    <form id="searchForm" action="/search" method="POST">
      <div class="filters">
        <div class="field">
          <label for="code">EMDN nomenclature code</label>
          <input
            id="code"
            name="code"
            value="<%= code %>"
            placeholder="e.g. A0101010202"
            required
            autocomplete="off"
          >
        </div>

        <div class="field">
          <label for="riskClass">Filter by risk class</label>
          <select id="riskClass" name="riskClass">
            <option value="all"
              <%= selectedRisk === "all" ? "selected" : "" %>>
              All available risk classes
            </option>

            <% riskClasses.forEach((risk) => { %>
              <option
                value="<%= risk.id %>"
                <%= selectedRisk === risk.id ? "selected" : "" %>>
                <%= risk.label %>
              </option>
            <% }) %>
          </select>
        </div>

        <button class="btn btn-primary" id="searchButton" type="submit">
          <span>⌕</span> Search devices
        </button>
      </div>
    </form>
  </section>

  <% if (error) { %>
    <div class="error">
      <strong>Something went wrong</strong>
      <p><%= error %></p>
    </div>
  <% } %>

  <section class="stats">
    <div class="stat-card">
      <div class="stat-icon">▤</div>
      <div>
        <div class="stat-label">Records displayed</div>
        <div class="stat-value"><%= rows.length.toLocaleString() %></div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon green">⇩</div>
      <div>
        <div class="stat-label">Records fetched</div>
        <div class="stat-value"><%= (totalRecords || 0).toLocaleString() %></div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon orange">⚑</div>
      <div>
        <div class="stat-label">Risk classes available</div>
        <div class="stat-value"><%= riskClasses.length %></div>
      </div>
    </div>
  </section>

  <section>
    <div class="results-header">
      <div>
        <h2 class="results-title">Device records</h2>
        <p class="results-description">
          EMDN code: <strong><%= code %></strong>
          · Export includes the rows currently displayed.
        </p>
      </div>

      <div class="results-actions">
        <button class="btn btn-excel" id="downloadExcel" type="button"
          <%= rows.length === 0 ? "disabled" : "" %>>
          <span>▦</span> Download Excel
        </button>

        <button class="btn btn-secondary" id="downloadCsv" type="button"
          <%= rows.length === 0 ? "disabled" : "" %>>
          Download CSV
        </button>
      </div>
    </div>

    <div class="table-wrap">
      <table id="deviceTable">
        <thead>
          <tr>
            <th>#</th>
            <th>Trade name</th>
            <th>Device name</th>
            <th>Device model</th>
            <th>Primary DI</th>
            <th>Basic UDI</th>
            <th>Reference</th>
            <th>Risk class ID</th>
            <th>Manufacturer</th>
            <th>Manufacturer SRN</th>
            <th>Device status ID</th>
            <th>Authorised representative</th>
            <th>AR SRN</th>
            <th>Criterion</th>
            <th>All fields</th>
          </tr>
        </thead>

        <tbody>
          <% if (rows.length === 0) { %>
            <tr>
              <td colspan="15">
                <div class="empty">
                  <div class="empty-icon">⌕</div>
                  <strong>No records to display</strong>
                  <p>Enter an EMDN code and search for matching devices.</p>
                </div>
              </td>
            </tr>
          <% } %>

          <% rows.forEach((row, index) => { %>
            <tr>
              <td class="index-cell"><%= index + 1 %></td>
              <td class="device-name"><%= row.TRADE_NAME ?? "-" %></td>
              <td><%= row.DEVICE_NAME ?? "-" %></td>
              <td><%= row.DEVICE_MODEL ?? "-" %></td>
              <td><%= row.PRIMARY_DI ?? "-" %></td>
              <td><%= row.BASIC_UDI ?? "-" %></td>
              <td><%= row.REFERENCE ?? "-" %></td>
              <td><span class="risk"><%= row.riskLabel ?? "-" %></span></td>
              <td><%= row.MF_NAME ?? "-" %></td>
              <td><%= row.MF_SRN ?? "-" %></td>
              <td><%= row.DEVICE_STATUS_TYPE_ID ?? "-" %></td>
              <td><%= row.AR_NAME ?? "-" %></td>
              <td><%= row.AR_SRN ?? "-" %></td>
              <td><%= row.DEVICE_CRITERION ?? "-" %></td>

              <td>
                <details class="details">
                  <summary>View all data</summary>
                  <pre><%= JSON.stringify(row, null, 2) %></pre>
                </details>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <footer class="footer">
    EUDAMED Explorer · Data is presented for research and review.
  </footer>
</div>

<!-- Loading overlay -->
<div class="loader-overlay" id="loaderOverlay" aria-live="polite"
  aria-label="Loading device data">
  <div class="loader-card">
    <div class="loader-animation">
      <div class="loader-ring"></div>
      <div class="loader-ring ring-two"></div>
      <div class="loader-symbol">✚</div>
    </div>

    <h2>Fetching device records</h2>
    <p>
      Connecting to the EUDAMED data service.<br>
      Large result sets may take a little longer.
    </p>

    <div class="loader-progress">
      <span></span>
    </div>
  </div>
</div>

<script>
  const searchForm = document.getElementById("searchForm");
  const loader = document.getElementById("loaderOverlay");
  const searchButton = document.getElementById("searchButton");

  // Show the animated loader when submitting the search form.
  searchForm.addEventListener("submit", function () {
    loader.classList.add("active");
    searchButton.disabled = true;
    searchButton.textContent = "Searching...";
  });

  // Export only the data rows currently displayed in the table.
  function getExportRows() {
    const table = document.getElementById("deviceTable");
    const headerCells = [...table.querySelectorAll("thead th")];

    // Do not export the row number or the "All fields" disclosure column.
    const exportIndexes = headerCells
      .map((th, index) => ({ title: th.innerText.trim(), index }))
      .filter((item) => item.title !== "#" && item.title !== "All fields");

    const headers = exportIndexes.map((item) => item.title);

    const bodyRows = [...table.querySelectorAll("tbody tr")]
      .filter((tr) => tr.querySelectorAll("td").length > 1)
      .map((tr) => {
        const cells = [...tr.querySelectorAll(":scope > td")];

        return exportIndexes.map((item) => {
          const cell = cells[item.index];
          return cell ? cell.innerText.trim() : "";
        });
      });

    return [headers, ...bodyRows];
  }

  function createFilename(extension) {
    const code = document.getElementById("code").value.trim()
      .replace(/[^a-zA-Z0-9_-]/g, "_");

    const risk = document.getElementById("riskClass").value
      .replace(/[^a-zA-Z0-9_-]/g, "_");

    const filterSuffix = risk === "all" ? "all_risks" : `risk_${risk}`;

    return `EUDAMED_${code}_${filterSuffix}.${extension}`;
  }

  document.getElementById("downloadExcel").addEventListener("click", function () {
    if (typeof XLSX === "undefined") {
      alert("Excel library could not load. Please check your internet connection.");
      return;
    }

    const data = getExportRows();

    if (data.length <= 1) {
      alert("There are no records to export.");
      return;
    }

    const worksheet = XLSX.utils.aoa_to_sheet(data);
    worksheet["!cols"] = data[0].map((header, index) => ({
      wch: Math.min(
        Math.max(
          String(header).length + 4,
          ...data.slice(1, Math.min(data.length, 25))
            .map((row) => String(row[index] ?? "").length + 2)
        ),
        35
      )
    }));

    const workbook = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(workbook, worksheet, "Device Records");

    XLSX.writeFile(workbook, createFilename("xlsx"));
  });

  document.getElementById("downloadCsv").addEventListener("click", function () {
    const data = getExportRows();

    if (data.length <= 1) {
      alert("There are no records to export.");
      return;
    }

    const csv = data.map((row) =>
      row.map((value) =>
        '"' + String(value ?? "").replace(/"/g, '""') + '"'
      ).join(",")
    ).join("\r\n");

    const blob = new Blob(["\uFEFF" + csv], {
      type: "text/csv;charset=utf-8;"
    });

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download = createFilename("csv");
    link.click();

    URL.revokeObjectURL(url);
  });
</script>
</body>
</html>
